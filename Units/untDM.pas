{%CLASSGROUP 'System.Classes.TPersistent'}

{$R *.dfm}

{ TDM }

procedure TDM.DataModuleCreate(Sender: TObject);
begin
    try
      with CONEXAO do
        begin
          Close;
          Params.Clear;
          if FileExists('C:\SistemaOdon\Banco\caminho_bd_full.ini') then
          begin
            Params.LoadFromFile('C:\SistemaOdon\Banco\caminho_bd_full.ini');
             Open;
          end
          else
          begin
            Application.MessageBox('Caminho da base de dados não corresponde.','Atenção', MB_OK + MB_ICONWARNING);
            Application.Terminate;
          end;

        end;
    except
      Application.MessageBox('Erro ao tentar conectar-se ao banco.','Atenção', MB_OK + MB_ICONWARNING);
      Application.Terminate;
    end;
end;

function TDM.NewTransactionID: LongWord;
var
  lGUID: TGUID;
begin
  CreateGUID(lGUID);
  Result := lGUID.D1;
end;

end.
